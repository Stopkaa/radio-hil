#!/usr/bin/env python3
# This script is generated by AI
"""radio-hil - minimal client for the radio-hil Pis (runs on your laptop)

Examples:
    radio-hil fetch
    radio-hil list
    radio-hil flash -b nrf52840dk-1 nrf52840dk-2 -f app.elf
    radio-hil build-flash -b nrf52840dk-2 frdm-kw41z-1 -f examples/basic/hello-world
    radio-hil term nrf52840dk-1
    radio-hil reset -b nrf52840dk-1        (or -a for all, -u for all in use)
    radio-hil power off -a                 (or -b <names>, -u)

Board names are <RIOT board>-<n>, where n is the trailing number of the
Pi's host name (radio-hil-1 -> 1, radio-hil-2 -> 2). Hosts without a
trailing number get their position in the host list instead. Each Pi has
every board type at most once.

The Pis are reached as ssh hosts radio-hil-1, radio-hil-2 (set them up in
~/.ssh/config), or set RADIO_HIL_HOSTS="host1 host2 ...".
power/reset need radio-hil-power installed on the Pis.

Note: build-flash builds with your local RIOT checkout, but flashing and
the terminal go through the RIOT checkout on the Pis (PI_APP). Keep both
roughly in sync, otherwise flasher configs or programmer flags may differ
and flashing fails in confusing ways.
"""

import argparse
import functools
import getpass
import json
import os
import re
import shlex
import subprocess
import sys

HOSTS = os.environ.get("RADIO_HIL_HOSTS", "radio-hil-1 radio-hil-2").split()
CACHE = os.path.expanduser("~/.cache/radio-hil/boards.json")
# Give up quickly on Pis that are switched off or unreachable
SSH_OPTS = ["-o", "ConnectTimeout=3"]
# Any RIOT application on the Pis, only used as make context for flash/term
PI_APP = "/srv/radio-hil/RIOT/examples/basic/hello-world"


def die(msg):
    print(f"radio-hil: {msg}", file=sys.stderr)
    sys.exit(1)


def warn(msg):
    print(f"radio-hil: {msg}", file=sys.stderr)


def ssh(host, cmd, tty=False, capture=False):
    args = ["ssh", *SSH_OPTS] + (["-t"] if tty else []) + [host, cmd]
    return subprocess.run(args, text=True, capture_output=capture)


def ssh_stream(host, cmd):
    """Run cmd on host, print its output line by line, return all of it."""
    proc = subprocess.Popen(["ssh", *SSH_OPTS, host, cmd], stdout=subprocess.PIPE, text=True)
    lines = []
    for line in proc.stdout:
        print(line, end="", flush=True)
        lines.append(line)
    proc.wait()
    return "".join(lines)


@functools.lru_cache(maxsize=None)
def load_boards():
    try:
        with open(CACHE) as fh:
            return json.load(fh)
    except FileNotFoundError:
        die("no board list yet, run 'radio-hil fetch' first")


def entry(name):
    boards = load_boards()
    if name not in boards:
        die(f"unknown board '{name}' (known: {', '.join(sorted(boards))})")
    if not isinstance(boards[name], dict) or "host" not in boards[name]:
        die("board list is outdated, run 'radio-hil fetch' again")
    return boards[name]


def group_by_host(names):
    """{host: [(name, uid), ...]} for the given board names."""
    groups = {}
    for name in names:
        e = entry(name)
        groups.setdefault(e["host"], []).append((name, e["uid"]))
    return groups


# --- fetch / list -----------------------------------------------------------

def host_number(host, position):
    """Trailing number of the host name (radio-hil-2 -> 2), else position."""
    m = re.search(r"-(\d+)$", host)
    return int(m.group(1)) if m else position


def cmd_fetch():
    boards = {}
    numbers = {}
    for position, host in enumerate(HOSTS, start=1):
        idx = host_number(host, position)
        if idx in numbers:
            die(f"{host} and {numbers[idx]} both map to number {idx}, "
                f"rename one of them in RADIO_HIL_HOSTS")
        numbers[idx] = host
        res = ssh(host, "cat ${NM_CONFIG_DIR:-/etc/inet-nm}/nodes.json", capture=True)
        if res.returncode != 0:
            warn(f"{host} not reachable, skipped ({res.stderr.strip()})")
            continue
        count = 0
        for n in json.loads(res.stdout):
            if n.get("ignore"):
                continue
            name = f"{n['board']}-{idx}"
            if name in boards:
                warn(f"{host} has {n['board']} more than once, skipped {n['uid']}")
                continue
            boards[name] = {"uid": n["uid"], "board": n["board"], "host": host}
            count += 1
        print(f"{host}: {count} boards")
    if not boards:
        die("no boards fetched")
    os.makedirs(os.path.dirname(CACHE), exist_ok=True)
    with open(CACHE, "w") as fh:
        json.dump(boards, fh, indent=2, sort_keys=True)
    load_boards.cache_clear()
    cmd_list()


def cmd_list():
    for name in sorted(load_boards()):
        print(name)


# --- flash / build-flash ----------------------------------------------------

def flash(name, firmware):
    """Copy firmware to the board's Pi and flash it, returns True on success."""
    e = entry(name)
    host, uid = e["host"], e["uid"]
    remote = f"/tmp/{getpass.getuser()}-{name}{os.path.splitext(firmware)[1]}"
    if subprocess.run(["scp", *SSH_OPTS, "-q", firmware, f"{host}:{remote}"]).returncode != 0:
        warn(f"copying the firmware to {host} failed")
        return False
    make = (f"make -C {PI_APP} BOARD=$NM_BOARD DEBUG_ADAPTER_ID=$NM_SERIAL PORT=$NM_PORT "
            f"FLASHFILE={remote} flash-only")
    # remove the copied firmware afterwards, whatever the result
    out = ssh_stream(host, f"inet-nm-exec {shlex.quote(make)} -d {uid}; "
                           f"rm -f {shlex.quote(remote)}")
    if "RESULT:" not in out:
        warn(f"'{name}' was not flashed, it is in use by someone else or not connected")
        return False
    if not out.rstrip().endswith(": 0"):
        warn(f"flashing '{name}' failed, see output above")
        return False
    return True


def cmd_flash(names, firmware):
    if not os.path.isfile(firmware):
        die(f"firmware '{firmware}' not found")
    failed = [name for name in names if not flash(name, firmware)]
    if failed:
        die(f"not flashed: {', '.join(failed)}")


def build(app, board):
    """Build app for board, returns the file the board's flasher needs."""
    jobs = f"-j{os.cpu_count() or 1}"
    if subprocess.run(["make", jobs, "-C", app, f"BOARD={board}"]).returncode != 0:
        die(f"build for {board} failed")
    # ask RIOT which file the flasher of this board needs (.elf, .bin, .hex)
    res = subprocess.run(["make", "-s", "--no-print-directory", "-C", app, f"BOARD={board}",
                          "info-debug-variable-FLASHFILE"], capture_output=True, text=True)
    firmware = res.stdout.strip().splitlines()[-1] if res.stdout.strip() else ""
    if res.returncode != 0 or not firmware:
        die(f"could not determine the flash file for {board}:\n{res.stderr}")
    if not os.path.isfile(firmware):
        die(f"build for {board} did not produce '{firmware}'")
    return firmware


def cmd_build_flash(names, app):
    boards = {name: entry(name)["board"] for name in names}   # fails early on typos
    firmware = {}
    for board in dict.fromkeys(boards.values()):              # build each type once
        firmware[board] = build(app, board)
    failed = []
    for name, board in boards.items():
        print(f"==> flashing {name} with {firmware[board]}")
        if not flash(name, firmware[board]):
            failed.append(name)
    if failed:
        die(f"not flashed: {', '.join(failed)}")
    print(f"==> flashed: {', '.join(names)}")


# --- term -------------------------------------------------------------------

def cmd_term(name):
    e = entry(name)
    make = f"make -C {PI_APP} BOARD=$NM_BOARD PORT=$NM_PORT term"
    # The Pi may not know the local terminal type (e.g. xterm-kitty) and
    # tmux refuses to start then, so always use a type every system knows.
    # Own tmux session per board (-n), otherwise a second 'term' takes over
    # the session of the first one.
    ssh(e["host"], f"TERM=xterm-256color inet-nm-tmux -n {name} -d {e['uid']} "
                   f"-x {shlex.quote(make)}", tty=True)


# --- power / reset ----------------------------------------------------------

def power(action, names, all_boards, in_use):
    # radio-hil-power is installed on the Pis (/usr/local/bin);
    # -a (all) and -u (in use) are resolved there
    if all_boards or in_use:
        flag = "-a" if all_boards else "-u"
        jobs = {host: flag for host in HOSTS}
    elif names:
        jobs = {host: " ".join(uid for _, uid in members)
                for host, members in group_by_host(names).items()}
    else:
        die("give boards with -b, or -a for all, or -u for all in use")
    failed = False
    for host, arg in jobs.items():
        res = ssh(host, f"radio-hil-power {action} {arg}", capture=True)
        print(res.stdout, end="")
        if res.returncode != 0:
            warn(f"{host}: power {action} failed: {res.stderr.strip()}")
            failed = True
    if failed:
        sys.exit(1)


# --- main -------------------------------------------------------------------

def main():
    parser = argparse.ArgumentParser(
        prog="radio-hil", description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="cmd", required=True)

    sub.add_parser("fetch", help="get the boards of all Pis")
    sub.add_parser("list", help="show the fetched boards")

    p = sub.add_parser("flash", help="copy a firmware file to the Pi and flash it")
    p.add_argument("-b", "--boards", nargs="+", required=True, metavar="NAME")
    p.add_argument("-f", "--file", required=True, help="firmware file (.elf/.bin/.hex)")

    p = sub.add_parser("build-flash", help="build an application and flash it")
    p.add_argument("-b", "--boards", nargs="+", required=True, metavar="NAME")
    p.add_argument("-f", "--folder", required=True, help="RIOT application folder")

    p = sub.add_parser("term", help="open the RIOT shell of a board")
    p.add_argument("board", metavar="NAME")

    for cmd, text in (("reset", "power cycle boards"), ("power", "switch USB power")):
        p = sub.add_parser(cmd, help=text)
        if cmd == "power":
            p.add_argument("action", choices=("on", "off"))
        g = p.add_mutually_exclusive_group(required=True)
        g.add_argument("-b", "--boards", nargs="+", metavar="NAME")
        g.add_argument("-a", "--all", action="store_true", help="all boards")
        g.add_argument("-u", "--used", action="store_true", help="all boards in use")

    args = parser.parse_args()
    if args.cmd == "fetch":
        cmd_fetch()
    elif args.cmd == "list":
        cmd_list()
    elif args.cmd == "flash":
        cmd_flash(args.boards, args.file)
    elif args.cmd == "build-flash":
        cmd_build_flash(args.boards, args.folder)
    elif args.cmd == "term":
        cmd_term(args.board)
    elif args.cmd == "reset":
        power("reset", args.boards, args.all, args.used)
    elif args.cmd == "power":
        power(args.action, args.boards, args.all, args.used)


if __name__ == "__main__":
    main()
